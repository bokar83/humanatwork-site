# HAW per-slug marketing redirects + branded shorteners
# Generated by scripts/regenerate_haw_htaccess.py
# Source of truth: docs/products/gumroad-manifest-2026-05-16.json
# Strategy: redirect every slug to /store with UTM attribution
# (keeps reader on HAW domain; per-SKU click via /store cards)
# Shorteners /k/ /x/ /r/ added 2026-05-18 per feedback_short_links_for_long_urls.md
#
# DO NOT hand-edit. Re-run the generator instead.
# Generated: 2026-05-18 20:52:19 Mountain Daylight Time
# Slug rules: 62  Shortener rules: 16  Catch-all: 1

RewriteEngine On

# --- Branded shorteners --- preserve UTM behind the scenes ---
# Pattern: /k/<slug> = email-channel kit links
# Pattern: /x/<slug> = X-channel post links
# Pattern: /r/<slug> = Reddit-channel post links
RewriteRule ^k/start-ai-24h/?$ /store/?utm_source=email&utm_medium=beehiiv&utm_campaign=haw_launch&utm_content=start-ai-24h [R=301,L,QSA]
