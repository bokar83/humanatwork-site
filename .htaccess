# --- Catch-all for any slug not in the manifest ---
# Matches single-segment paths only (no slashes inside the slug)
# and skips real files/directories. 302 (not 301) so the rule
# can be replaced with a per-SKU 301 once that slug ships.
# utm_content=<slug>-unknown distinguishes catch-all hits in
# Plausible from intentional reel hits.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^([A-Za-z0-9][A-Za-z0-9\-]*)/?$ /store/?utm_source=reel&utm_content=$1-unknown [R=302,L,QSA]
